# ================= 知答 ZhiDa 配置模板 =================
# 复制为 .env 并填入真实值。密钥绝不提交到仓库。

# ===== LLM 网关（DeepSeek OpenAI 兼容，可按需换其他兼容网关）=====
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your-deepseek-api-key-here
# 生产建议 deepseek-flash（V4.1-Flash 非思考模式，最省）。
# 旧别名 deepseek-chat 实测等同于它；deepseek-v4-pro 贵 4~7 倍，RAG 摘录型回答无需。
LLM_MODEL_NAME=deepseek-flash
LLM_TIMEOUT=60000
LLM_MAX_RETRY=3
LLM_RETRY_DELAY_BASE=2
LLM_MAX_OUTPUT_TOKENS=2048

# ===== 提示词 =====
PROMPT_DIR=./prompts
PROMPT_RELOAD_ON_EACH_CALL=true

# ===== 服务 =====
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# ===== Embedding（本地 BGE 模型）=====
EMBED_MODEL_NAME=./models/bge-small-zh
EMBED_DEVICE=cpu   # auto / cpu / mps(Mac) / cuda

# ===== 文本分块 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ===== Qdrant 向量库 =====
QDRANT_HOST=qdrant     # Docker 内为服务名 qdrant；本地运行改 127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=zhida
VECTOR_DIM=512

# ===== 检索 =====
RETRIEVE_TOP_K=5               # 合同/制度类长文建议 5；小块短文可下调到 3
RETRIEVAL_MODE=hybrid          # dense / hybrid
HYBRID_DENSE_CANDIDATES=20
HYBRID_KEYWORD_CANDIDATES=20
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=3.0

# ===== 多轮对话 =====
QUERY_REWRITE_ENABLED=true
CONVERSATION_MAX_TURNS=5
CONVERSATION_TTL_SECONDS=3600

# ===== 多租户 / 知识库隔离 =====
DEFAULT_TENANT_ID=default      # 未认证/未指定时的租户
DEFAULT_KB_ID=default          # 请求未传 kb_id 时的知识库
TENANT_API_KEYS=               # 程序调用的多租户映射："tenantA=keyA,tenantB=keyB"

# ===== 浏览器登录（Cookie 会话）=====
AUTH_USERS=                    # "alice:<密码哈希>:tenantA,bob:<哈希>:tenantB"；用 scripts/hash_password.py 生成
SESSION_SECRET=                # 必填：openssl rand -hex 32
SESSION_TTL_SECONDS=28800      # 登录有效期 8 小时
COOKIE_SECURE=false            # HTTPS 部署置 true

# ===== 安全可观测 =====
AUTH_ENABLED=false             # 私有化交付时置 true；浏览器走登录，程序走 API Key
SERVICE_API_KEY=change-me      # 程序调用密钥，映射 default 租户；X-API-Key 或 Authorization: Bearer
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ===== Redis（多实例高可用）=====
REDIS_ENABLED=false            # false=进程内存（单实例）；true=Redis（多实例横向扩展）
REDIS_HOST=redis               # Docker 内为服务名 redis；本地运行改 127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=zhida
