# ================= 知答 ZhiDa 配置模板 =================
# 复制为 .env 并填入真实值。密钥绝不提交到仓库。

# ===== LLM 网关（DeepSeek OpenAI 兼容，可按需换其他兼容网关）=====
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your-deepseek-api-key-here
LLM_MODEL_NAME=deepseek-chat
LLM_TIMEOUT=60000
LLM_MAX_RETRY=3
LLM_RETRY_DELAY_BASE=2
LLM_MAX_OUTPUT_TOKENS=2048

# ===== 提示词 =====
PROMPT_DIR=./prompts
PROMPT_RELOAD_ON_EACH_CALL=true

# ===== 服务 =====
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# ===== Embedding（本地 BGE 模型）=====
EMBED_MODEL_NAME=./models/bge-small-zh
EMBED_DEVICE=cpu   # auto / cpu / mps(Mac) / cuda

# ===== 文本分块 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ===== Qdrant 向量库 =====
QDRANT_HOST=qdrant     # Docker 内为服务名 qdrant；本地运行改 127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=zhida
VECTOR_DIM=512

# ===== 检索 =====
RETRIEVE_TOP_K=3
RETRIEVAL_MODE=hybrid          # dense / hybrid
HYBRID_DENSE_CANDIDATES=20
HYBRID_KEYWORD_CANDIDATES=20
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=3.0

# ===== 多轮对话 =====
QUERY_REWRITE_ENABLED=true
CONVERSATION_MAX_TURNS=10
CONVERSATION_TTL_SECONDS=3600

# ===== 安全可观测 =====
AUTH_ENABLED=false             # 私有化交付时置 true
SERVICE_API_KEY=change-me      # auth_enabled=true 时必填；客户端用 X-API-Key 或 Authorization: Bearer 传
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ===== Redis（多实例高可用）=====
REDIS_ENABLED=false            # false=进程内存（单实例）；true=Redis（多实例横向扩展）
REDIS_HOST=redis               # Docker 内为服务名 redis；本地运行改 127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=zhida
